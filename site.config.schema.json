{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.config.schema.json",
  "title": "tube-template site configuration",
  "description": "One file per site. Relative paths are relative to this config file. Secrets are never stored here: only the NAMES of files in ~/.secrets (or $TUBE_SECRETS_DIR).",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "videos"],
  "properties": {
    "$schema": { "type": "string" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Site name shown in the header, titles and footer." },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,23}$", "description": "Machine name (images, units, default resource prefix). Default: derived from name." },
        "tagline": { "type": "string", "maxLength": 120, "description": "Niche / tagline, used in the home <title> and meta description." },
        "description": { "type": "string", "maxLength": 300, "description": "Default meta description. Default: '<name> : <tagline>'." },
        "language": { "enum": ["fr", "en"], "description": "UI language (app/locales/<lang>.json) and search stemming." },
        "accent_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "logo_text": { "type": "string", "maxLength": 40, "description": "Text logo. The last capitalised word gets the accent colour. Default: name." }
      }
    },
    "content_label": {
      "type": "object",
      "additionalProperties": false,
      "description": "Disclosure label on every video page + a badge on thumbnails (default: the AI-generated label of the language).",
      "properties": {
        "enabled": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 80 },
        "badge": { "type": "string", "maxLength": 12 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": ["string", "null"], "maxLength": 500, "description": "Footer paragraph. null = the language default (mentions the content label when enabled)." },
        "legal": { "type": "string", "maxLength": 500, "description": "Small print after the copyright line (legal notice, host, contact)." }
      }
    },
    "private": { "type": "boolean", "description": "true (default): HTTP basic auth on everything + noindex + robots Disallow all." },
    "media_base": { "type": "string", "minLength": 1, "description": "'/media' (served by the box) or https://cdn.example.com (a CDN / edge hostname)." },
    "strings": { "type": "object", "description": "Overrides of app/locales/<lang>.json keys (same nesting)." },
    "videos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": { "type": "string", "minLength": 1, "description": "Video folder. Each subfolder = one category (folder name -> slug + display name)." },
        "manifest": { "type": "string", "description": "Optional CSV or JSON overriding title/description/tags/category/hidden per video, keyed by relative path or file name." },
        "default_category": { "type": "string", "minLength": 1, "description": "Category for files directly in the root folder. Default: 'Videos' / 'Vidéos'." },
        "extensions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]{2,5}$" }, "minItems": 1 }
      }
    },
    "categories": {
      "type": "object",
      "description": "Keyed by category slug (as derived from the folder name): rename, order, hide.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "position": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "hidden": { "type": "boolean" }
        }
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "out_dir": { "type": "string", "minLength": 1, "description": "Pipeline output (out/media + catalog.json). Default: out" },
        "ladder": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "description": "HLS rungs by SHORT side, never upscaled.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["short", "video_kbps", "audio_kbps"],
            "properties": {
              "short": { "type": "integer", "minimum": 144, "maximum": 2160 },
              "video_kbps": { "type": "integer", "minimum": 100, "maximum": 50000 },
              "audio_kbps": { "type": "integer", "minimum": 32, "maximum": 320 }
            }
          }
        },
        "segment_seconds": { "type": "integer", "minimum": 2, "maximum": 10 },
        "crf": { "type": "integer", "minimum": 15, "maximum": 35 },
        "preview_seconds": { "type": "number", "minimum": 2, "maximum": 20, "description": "Hover preview length (made of preview_snippets snippets)." },
        "preview_snippets": { "type": "integer", "minimum": 2, "maximum": 12 },
        "preview_max_kb": { "type": "integer", "minimum": 50, "maximum": 5000 },
        "poster_position": { "type": "number", "minimum": 0.05, "maximum": 0.95, "description": "Poster frame at this fraction of the duration (black/flat frames are skipped)." },
        "versioned_paths": { "type": "boolean", "description": "true: media at <id>/<v>/... so a re-encode never collides with immutable caches." },
        "jobs": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "ads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["placeholder", "off", "live"] },
        "slots": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "leaderboard": { "type": "boolean" },
            "sidebar": { "type": "boolean" },
            "inline_mobile": { "type": "boolean" },
            "native": { "type": "boolean" },
            "sticky": { "type": "boolean" },
            "preroll": { "type": "boolean" }
          }
        },
        "vast_url": { "type": "string", "pattern": "^(https://.+)?$" },
        "house_preroll": { "type": "boolean", "description": "Play the generated house pre-roll when no VAST tag is set." },
        "native_every": { "type": "integer", "minimum": 2, "maximum": 50 },
        "csp_origins": { "type": "array", "items": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?$" } }
      }
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "port": { "type": "integer", "minimum": 1024, "maximum": 65535 } }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["ovh", "ssh"] },
        "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,24}-$", "description": "Every cloud resource name starts with it; every destructive action refuses anything else. Default: '<slug>-'." },
        "domain": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$|^$", "description": "Public hostname. Empty: <ip-with-dashes>.sslip.io." },
        "tls": { "type": "boolean", "description": "Let's Encrypt certificate (webroot) after the first deploy." },
        "letsencrypt_email": { "type": "string" },
        "remote_root": { "type": "string", "pattern": "^/srv/[a-z0-9][a-z0-9._-]*$", "description": "Box root. Default: /srv/<slug>" },
        "media_origin": { "enum": ["bucket", "rsync"], "description": "bucket: the box pulls media from S3; rsync: pushed from out/media over SSH." },
        "ssh_key": { "type": "string", "description": "Private key used for SSH (public key = <key>.pub). Default ~/.ssh/id_ed25519" },
        "basic_auth": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "user": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
            "password_secret": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "Name of the file in ~/.secrets holding the password (generated on first deploy)." }
          }
        },
        "ovh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_id": { "type": "string", "pattern": "^([0-9a-f]{32})?$" },
            "endpoint": { "type": "string", "pattern": "^https://" },
            "token_secret": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "Name of the ~/.secrets file holding the OVH API bearer token." },
            "region": { "type": "string", "pattern": "^[A-Z0-9-]{2,20}$" },
            "fallback_regions": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9-]{2,20}$" } },
            "web_flavor": { "type": "string", "minLength": 2 },
            "loadgen_flavor": { "type": "string", "minLength": 2 },
            "image": { "type": "string", "minLength": 2 },
            "cap_minutes": { "type": "integer", "minimum": 30, "maximum": 525600, "description": "Watchdog parks the web box at cap-15 min and hard-deletes it at cap." },
            "loadgen_cap_minutes": { "type": "integer", "minimum": 30, "maximum": 1440 },
            "max_instances": { "type": "integer", "minimum": 1, "maximum": 10 },
            "protected_ids": { "type": "array", "items": { "type": "string", "minLength": 8 }, "description": "Instance/snapshot ids that are always refused, whatever their name." }
          }
        },
        "ssh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "allow_ssh_from": { "type": "string", "description": "ufw source for the SSH port: 'any' (default) or an IP/CIDR." },
            "harden": { "type": "boolean", "description": "Also apply the sshd hardening drop-in (key-only, no root login). Default false on a server you already use." }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "description": "rclone S3 provider: Other (OVH), Scaleway, Cloudflare (R2), Minio, AWS..." },
            "endpoint": { "type": "string", "pattern": "^(https?://.+)?$" },
            "region": { "type": "string" },
            "bucket": { "type": "string", "pattern": "^([a-z0-9][a-z0-9.-]{2,62})?$", "description": "Empty: auto-named <prefix>media-<6 hex> on `./tube bucket create`. Must start with the prefix." },
            "access_key_secret": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "secret_key_secret": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "price_gb_month": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
